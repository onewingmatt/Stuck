{
  "compilerOptions": {
    "composite": true,
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "noEmit": false,
    "outDir": "dist-node"
  },
  "include": ["vite.config.ts"]
}
