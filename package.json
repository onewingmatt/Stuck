{
  "name": "stuck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:ui": "vite",
    "dev:server": "tsx watch server/server.ts",
    "dev": "npm run dev:server & npm run dev:ui",
    "build:ui": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json && tsc-alias -p tsconfig.server.json",
